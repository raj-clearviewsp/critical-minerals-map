{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "retrieved_at",
    "registry_sha256",
    "source_url",
    "license",
    "license_evidence_url",
    "redistribution_ok",
    "files"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "raw-v1",
        "raw-v2"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "license_evidence_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "redistribution_ok": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "url",
          "final_url",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "final_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieval_evidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "acquisition_method": {
      "enum": [
        "browser_download",
        "user_existing_download"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "raw-v1"
          }
        }
      },
      "then": {
        "properties": {
          "retrieved_at": {
            "type": "string"
          },
          "files": {
            "items": {
              "properties": {
                "final_url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "raw-v2"
          }
        }
      },
      "then": {
        "required": [
          "registered_at",
          "acquisition_method"
        ],
        "properties": {
          "files": {
            "items": {
              "required": [
                "retrieved_at",
                "retrieval_evidence"
              ]
            }
          }
        }
      }
    }
  ]
}
