{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "site":{
      "type":"object","required":["id","name","country_iso3s","minerals","lat","lon","maturity_rung","evidence","record_ids","review_state"],
      "properties":{
        "id":{"type":"string","pattern":"^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},"name":{"type":"string","minLength":1},
        "country_iso3s":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z]{3}$"}},
        "minerals":{"type":"array","minItems":1,"items":{"enum":["REE","Ni","Co"]}},"lat":{"type":"number","minimum":-90,"maximum":90},"lon":{"type":"number","minimum":-180,"maximum":180},
        "maturity_rung":{"type":"integer","minimum":1,"maximum":5},"record_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "review_state":{"enum":["reviewed_physical_site","single_source_provisional"]},
        "evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["source_id","url","grade"],"properties":{"source_id":{"type":"string"},"url":{"type":"string","pattern":"^https?://"},"grade":{"enum":["A","B","C","D"]}}}}
      }
    },
    "profile":{"type":"object","required":["code","name","context"],"properties":{"code":{"type":"string","pattern":"^[A-Za-z]{2,3}$"},"name":{"type":"string","minLength":1},"context":{"type":"array","items":{"type":"object","required":["label","value","source_id","url","grade"],"properties":{"url":{"type":"string","pattern":"^https?://"},"grade":{"enum":["A","B","C","D"]}}}}}}
  }
}
