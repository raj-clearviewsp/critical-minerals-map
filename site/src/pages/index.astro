---
import Page from '../layouts/Page.astro';
import Explorer from '../components/Explorer.astro';
import { loadRelease, loadArchive, releaseExplorer, recordExplorer } from '../lib/release-data.mjs';
const release = loadRelease();
const dataset = release ? releaseExplorer(release) : recordExplorer(loadArchive(), null);
---
<Page title="Explore" active="explore" releaseTag={dataset.private_preview === false ? undefined : dataset.release_tag} dataDate={dataset.data_as_of}>
  <Explorer dataset={dataset}/>
</Page>
