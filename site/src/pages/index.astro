---
import { loadManifest } from '../lib/manifest.mjs';
import '../styles/global.css';
const manifest = loadManifest();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="A sourced reference for critical mineral deposits. The Atlas data preview is being prepared." />
    <title>Critical Minerals Atlas · Preview</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="wordmark" href="#overview">Critical Minerals Atlas</a>
      <nav aria-label="Main navigation">
        <a href="#data-status">Data status</a>
        <a href="#about">About</a>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <section class="intro" id="overview" aria-labelledby="page-title">
        <div class="preview-details" aria-label="Preview information">
          <p>Data as of: not yet available</p>
          <p>Preview version {manifest.release_tag}</p>
        </div>
        <h1 id="page-title">A global reference for<br class="desktop-break" /> critical mineral deposits.</h1>
        <p class="lede">Where deposits are found, how far they are from production, and who operates them — with the evidence behind each fact.</p>
      </section>

      <section class="data-status" id="data-status" aria-labelledby="status-title">
        <h2 id="status-title">The data preview<br class="desktop-break" /> is in preparation.</h2>
        <div class="status-copy">
          <p>No records have been published.</p>
          <p>Source review and validation are under way. The map, deposit records and country figures will appear here when they are ready to use.</p>
        </div>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <div class="about-intro">
          <h2 id="about-title">About the Atlas</h2>
          <p>A public reference for people working on minerals policy. The first release will cover rare earth elements, nickel and cobalt around the world.</p>
        </div>
        <dl class="reading-guide">
          <div>
            <dt>Check the source</dt>
            <dd>Each published fact will link to its source, with a date and an evidence grade.</dd>
          </div>
          <div>
            <dt>Understand the stage</dt>
            <dd>Occurrences, resource estimates, reserves and operating mines will be clearly distinguished.</dd>
          </div>
          <div>
            <dt>Use the information</dt>
            <dd>Map views will have a table equivalent, with data downloads and pages formatted for printing.</dd>
          </div>
        </dl>
      </section>
    </main>

    <footer>
      <p>Critical Minerals Atlas</p>
      <p>Preview · No published data</p>
    </footer>
  </body>
</html>
