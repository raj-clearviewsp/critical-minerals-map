---
import Page from '../layouts/Page.astro';
import { loadRelease, loadArchive } from '../lib/release-data.mjs';
import { safeSourceUrl } from '../lib/preview-model.mjs';
import type { Source } from '../lib/catalog-types';
const release = loadRelease();
const sources:Source[] = release?.sources || loadArchive().sources;
---
<Page title="Sources" active="sources"><main id="main" class="reading-page" tabindex="-1">
<section class="page-intro"><h1>Sources</h1><p class="lede">Publisher records, dates, attribution and reuse terms for the Atlas.</p></section>
{sources.length ? <div class="source-register">{sources.map(s=><article id={s.id} class="register-row"><div><h2>{s.title}</h2>{safeSourceUrl(s.url) && <a href={safeSourceUrl(s.url)} target="_blank" rel="noopener noreferrer">Publisher source ↗</a>}</div>
  <dl class="facts-table">{[['License',s.license || 'See publisher terms'],['Attribution',s.attribution],['Source currency',s.currency],['Retrieved',s.retrieved_at || 'Date unrecorded'],['Evidence grade',s.grade],['Public redistribution',s.redistribution_ok === true ? 'Permitted under the recorded terms' : 'Clearance required']].filter(([,value])=>value).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
</article>)}</div> : <p class="empty-build">The public preview has no source catalog.</p>}
<section class="editorial-row"><h2>Map background</h2><p>Country boundaries are from <a href="https://www.naturalearthdata.com/about/terms-of-use/">Natural Earth</a>, a public-domain cartographic dataset. They provide geographic orientation.</p></section>
</main></Page>
